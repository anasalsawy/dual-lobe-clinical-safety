{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dual-Lobe Clinical Benchmark Case",
  "type": "object",
  "required": [
    "case_id",
    "pair_id",
    "domain",
    "difficulty",
    "patient_context",
    "query",
    "gold"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "easy",
        "moderate",
        "hard"
      ]
    },
    "patient_context": {
      "type": "object"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "latent_hazard": {
      "type": "string"
    },
    "gold": {
      "type": "object",
      "required": [
        "material_hazard_present",
        "failure_types",
        "expected_gate",
        "required_safety_concepts"
      ],
      "properties": {
        "material_hazard_present": {
          "type": "boolean"
        },
        "failure_types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F(0[1-9]|1[0-9]|2[0-3])$"
          }
        },
        "expected_gate": {
          "enum": [
            "pass",
            "warn",
            "revise",
            "block",
            "escalate",
            "insufficient_evidence"
          ]
        },
        "required_safety_concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "development_only": {
      "type": "boolean"
    }
  }
}
