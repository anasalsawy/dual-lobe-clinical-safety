# Models. Use any CrewAI/LiteLLM-compatible model identifiers.
DUAL_LOBE_A_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
DUAL_LOBE_B_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# Provider settings (optional depending on model/provider).
OPENAI_API_KEY=
OPENAI_API_BASE=

# Optional per-lobe overrides.
DUAL_LOBE_A_API_KEY=
DUAL_LOBE_B_API_KEY=
DUAL_LOBE_A_BASE_URL=
DUAL_LOBE_B_BASE_URL=

# Durable memory.
DUAL_LOBE_MEMORY_PATH=.dual_lobe_memory.jsonl

# Generous output budgets.
DUAL_LOBE_A_MAX_TOKENS=8000
DUAL_LOBE_A_MERGE_MAX_TOKENS=12000
DUAL_LOBE_B_VERIFY_MAX_TOKENS=6000
DUAL_LOBE_B_WORKER_MAX_TOKENS=6000

# Adaptive provider pacing / failover.
# auto = do not throttle unless a real limit is configured or learned.
# free = may use provider-specific FREE_RPM/FREE_TPM hints below.
# paid = never inherit free-tier hints; only explicit/learned real limits apply.
DUAL_LOBE_PROVIDER_TIER=auto
DUAL_LOBE_RATE_SAFETY=0.92
DUAL_LOBE_RETRY_ROUNDS=3
DUAL_LOBE_RETRY_BASE_SECONDS=1.5
DUAL_LOBE_RETRY_MAX_SECONDS=30
DUAL_LOBE_FAILOVER_ON_RATE_LIMIT=true
DUAL_LOBE_CROSS_ROLE_FAILOVER=true

# Optional free-tier hints. Leave blank to learn dynamically.
DUAL_LOBE_GROQ_FREE_RPM=
DUAL_LOBE_GROQ_FREE_TPM=
DUAL_LOBE_OPENROUTER_FREE_RPM=
DUAL_LOBE_OPENROUTER_FREE_TPM=

# Optional explicit fallback pools (JSON arrays) per role or globally.
# DUAL_LOBE_A_FALLBACKS=[{"model":"hosted_vllm/openai/gpt-oss-120b","base_url":"https://api.groq.com/openai/v1","api_key_env":"GROQ_API_KEY","tier":"free"}]
# DUAL_LOBE_FALLBACKS=[]

# ---------------------------------------------------------------------------
# Clinical mode (dual-lobe-clinical)
# ---------------------------------------------------------------------------
# Lobe B MUST be local in clinical mode. Examples:
#   DUAL_LOBE_B_MODEL=ollama/llama3.1:8b                       (Ollama on this machine)
#   DUAL_LOBE_B_MODEL=hosted_vllm/<model> + DUAL_LOBE_B_BASE_URL=http://127.0.0.1:8000/v1
# In-house inference servers that are not on loopback must be allowlisted by host name:
DUAL_LOBE_CLINICAL_LOCAL_HOSTS=
# require (default): refuse to run if B is not local. prefer: development only.
DUAL_LOBE_CLINICAL_B_LOCALITY=require
# Live B observation during A's run (extra local B calls).
DUAL_LOBE_CLINICAL_LIVE_B=true
# Optional institutional knowledge corpus (JSONL: id, source, text) for B's evidence retrieval.
DUAL_LOBE_CLINICAL_KNOWLEDGE_PATH=
